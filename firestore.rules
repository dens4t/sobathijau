rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Services collection
    // Public can read, only admins can write
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Requests collection
    // Public can read and create, only admins can update/delete
    match /requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Statistics collection
    // Public can read, only admins can write
    match /statistics/{statsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Counters collection
    // Public can read (for registration numbers), admins can write
    match /counters/{counterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admins collection
    // Users can only read their own admin document, no one can write
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Admins must be managed manually via Firebase Console
    }
  }
}
